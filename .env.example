# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Authentication & Session Secrets
AUTH_SECRET=finance_secure_session_key_replace_in_production
SESSION_TTL_DAYS=7

# Database Configuration (Defaults to local SQLite in data/finance.db)
DATABASE_URL=data/finance.db

# Optional AI Features / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

