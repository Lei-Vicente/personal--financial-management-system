# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Authentication & Session Secrets
AUTH_SECRET=finance_secure_session_key_replace_in_production
SESSION_TTL_DAYS=7

# Database Configuration:
# Local Development: Defaults to local SQLite in data/finance.db
DATABASE_URL=data/finance.db
# For Supabase (PostgreSQL / Production):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Client Keys (Optional if connecting directly via DATABASE_URL)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional AI Features / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

