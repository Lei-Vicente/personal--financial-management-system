"\"  const [localAccounts, setLocalAccounts] = useState<Account[]>(accounts);\\n\\n  useEffect(() => {\\n    if (accounts && accounts.length > 0) {\\n      setLocalAccounts(accounts);\\n    } else if (isOpen) {\\n      apiFetch('/api/accounts')\\n        .then(res => {\\n          if (res && res.accounts) setLocalAccounts(res.accounts);\\n        })\\n        .catch(() => {});\\n    }\\n  }, [accounts, isOpen]);\\n\\n  // Only reset/initialize form when modal opens or item to edit changes\\n  useEffect(() => {\\n    if (!isOpen) return;\\n\\n    if (billToEdit) {\\n      setName(billToEdit.name);\\n      setAmount(String(billToEdit.amount));\\n      setDueDate(billToEdit.due_date);\\n      setFrequency(billToEdit.frequency);\\n      setCategoryId(billToEdit.category_id || '');\\n      setAccountId(billToEdit.account_id || '');\\n      setNotes(billToEdit.notes || '');\\n    } else {\\n      setName('');\\n      setAmount('');\\n      const defaultDue = new Date();\\n      defaultDue.setDate(defaultDue.getDate() + 7);\\n      setDueDate(defaultDue.toISOString().split('T')[0]);\\n      setFrequency('MONTHLY');\\n\\n      const expenseCats = categories.filter(c => c.type === 'EXPENSE');\\n      if (expenseCats.length > 0) {\\n        setCategoryId(expenseCats[0].id);\\n      } else if (categories.length > 0) {\\n        setCategoryId(categories[0].id);\\n      } else {\\n        setCategoryId('');\\n      }\\n\\n      const availableAccounts = accounts.length > 0 ? accounts : localAccounts;\\n      if (availableAccounts.length > 0) {\\n        const def = availableAccounts.find(a => a.is_default === 1) || availableAccounts[0];\\n        setAccountId(def.id);\\n      } else {\\n        setAccountId('');\\n      }\\n      setNotes('');\\n    }\\n    setError(null);\\n  }, [isOpen, billToEdit]);\""